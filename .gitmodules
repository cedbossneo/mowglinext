[submodule "ros2/src/opennav_coverage"]
	path = ros2/src/opennav_coverage
	url = https://github.com/open-navigation/opennav_coverage.git
	branch = main
[submodule "ros2/src/external/universal-gnss"]
	path = ros2/src/external/universal-gnss
	# Universal GNSS downstream compatibility is validated against upstream main.
	# MowgliNext pins the exact validated commit through the parent gitlink.
	url = https://github.com/Pepeuch/universal-gnss.git
	branch = main
